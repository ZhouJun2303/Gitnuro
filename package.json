{
  "name": "awegit",
  "version": "2.0.0",
  "description": "AweGit desktop client",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "start": "node ./scripts/with-rust-path.mjs tauri dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node ./scripts/with-rust-path.mjs cargo test -p awegit-git -- --test-threads=1",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/package-windows.ps1",
    "package:mac": "sh ./scripts/package-mac.sh",
    "tauri": "node ./scripts/with-rust-path.mjs tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.12.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
