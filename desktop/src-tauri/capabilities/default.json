{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-workspace-status",
    "allow-stage-all",
    "allow-unstage-all",
    "allow-stage-path",
    "allow-unstage-path",
    "allow-commit-changes",
    "allow-file-diff"
  ]
}
