{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-workspace-status",
    "allow-stage-all",
    "allow-unstage-all",
    "allow-stage-path",
    "allow-unstage-path",
    "allow-commit-changes",
    "allow-file-diff",
    "allow-commit-log",
    "allow-repository-refs",
    "allow-commit-files",
    "allow-show-commit-file",
    "allow-in-progress",
    "allow-mutate",
    "allow-file-history",
    "allow-blame-file",
    "allow-load-settings",
    "allow-save-settings",
    "allow-watch-repository",
    "allow-open-terminal",
    "allow-suggest-commit-message"
  ]
}
