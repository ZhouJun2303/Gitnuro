{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-workspace-status",
    "allow-stage-all",
    "allow-unstage-all",
    "allow-stage-path",
    "allow-unstage-path",
    "allow-commit-changes",
    "allow-file-diff",
    "allow-commit-log",
    "allow-commit-detail",
    "allow-repository-refs",
    "allow-commit-files",
    "allow-show-commit-file",
    "allow-in-progress",
    "allow-mutate",
    "allow-file-history",
    "allow-blame-file",
    "allow-load-settings",
    "allow-save-settings",
    "allow-watch-repository",
    "allow-open-terminal",
    "allow-pick-directory",
    "allow-suggest-commit-message",
    "allow-file-preview",
    "allow-cancel-operation",
    "allow-set-passphrase",
    "allow-approve-credential",
    "allow-check-for-update",
    "allow-conflict-sides",
    "allow-compare-files",
    "allow-compare-file",
    "allow-set-repo-author",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}
