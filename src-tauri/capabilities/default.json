{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, a second workspace, and the merge window",
  "windows": ["main", "desk", "merge"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "mailto:*" },
        { "url": "http://127.0.0.1*" },
        { "url": "http://localhost*" }
      ]
    },
    "allow-workspace-status",
    "allow-stage-all",
    "allow-unstage-all",
    "allow-stage-path",
    "allow-unstage-path",
    "allow-commit-changes",
    "allow-file-diff",
    "allow-commit-log",
    "allow-commit-detail",
    "allow-locate-ref",
    "allow-repository-refs",
    "allow-commit-files",
    "allow-show-commit-file",
    "allow-in-progress",
    "allow-mutate",
    "allow-file-history",
    "allow-blame-file",
    "allow-load-settings",
    "allow-save-settings",
    "allow-settings-path",
    "allow-import-fork-settings",
    "allow-external-tools",
    "allow-program-exists",
    "allow-watch-repository",
    "allow-open-terminal",
    "allow-clipboard-text",
    "allow-pick-directory",
    "allow-pick-file",
    "core:window:allow-set-title",
    "allow-suggest-commit-message",
    "allow-test-ai-endpoint",
    "allow-list-ai-models",
    "allow-file-preview",
    "allow-cancel-operation",
    "allow-set-passphrase",
    "allow-approve-credential",
    "allow-check-for-update",
    "allow-app-version",
    "allow-download-update",
    "allow-conflict-sides",
    "allow-conflict-view",
    "allow-compare-files",
    "allow-compare-file",
    "allow-set-repo-author",
    "allow-revision-preview",
    "allow-blob-view",
    "allow-reflog",
    "allow-commit-tree",
    "allow-repository-summary",
    "allow-rebase-conflicts",
    "allow-lfs-locks",
    "allow-launch-tool",
    "allow-forge-notifications",
    "allow-forge-pulls",
    "allow-log-client",
    "allow-perf-snapshot",
    "allow-diagnostics",
    "allow-open-log-folder",
    "allow-repo-facts",
    "allow-scan-repositories",
    "allow-mark-notification",
    "allow-create-github-repo",
    "allow-generate-ssh-key",
    "allow-search-commits",
    "allow-search-log",
    "allow-cherry-preview",
    "allow-merge-preview",
    "allow-merge-state",
    "allow-merged-branches",
    "allow-pick-history",
    "allow-activity-log",
    "allow-create-hosted-repo",
    "allow-device-start",
    "allow-device-poll",
    "allow-review-branch",
    "allow-read-ssh-config",
    "allow-write-ssh-config",
    "allow-open-editor",
    "allow-open-window",
    "allow-reveal-commit",
    "allow-save-revision",
    "allow-reveal-path",
    "allow-git-runtime",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-scale-factor",
    "core:window:allow-set-size",
    "core:window:allow-set-position"
  ]
}
